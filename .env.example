# ---------------------------------------------------------------------------
# Copiar a .env: cp .env.example .env
# Todos los valores son placeholders: ajústalos con tus credenciales reales.
# ---------------------------------------------------------------------------

# --- AWS S3 (dataset de 500.000 reseñas) -----------------------------------
AWS_REGION=us-east-1
S3_BUCKET=tu-bucket-aquí
# Ruta del .zip dentro del bucket. Si el bucket ya contiene el CSV extraído,
# usa S3_REVIEWS_CSV_KEY en lugar de S3_REVIEWS_ZIP_KEY.
S3_REVIEWS_ZIP_KEY=raw/amazon-reviews-500k.zip
S3_REVIEWS_CSV_KEY=
# Déjalos vacíos si usas AWS_PROFILE o un rol de Instancia.
# Si usas ~/.aws/credentials del host, docker-compose.app.yml lo monta en
# /root/.aws (solo lectura) y AWS_PROFILE=default resuelve el perfil.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_PROFILE=default
# Para MinIO u otros endpoints S3-compatible:
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# --- Dataset local (alternativa a S3) --------------------------------------
# Ruta relativa al directorio raíz del proyecto, p. ej. data/reviews.csv
REVIEWS_CSV_PATH=data/reviews.csv
ALLOW_SYNTHETIC_REVIEWS=false
SYNTHETIC_REVIEW_ROWS=20000

# --- Ingesta / cruce --------------------------------------------------------
PRODUCTS_API_URL=https://dummyjson.com/products
PRODUCT_API_LIMIT=100
PRODUCT_COUNT=100
REVIEWS_PER_PRODUCT=20
REVIEW_POOL_SIZE=4000
INGEST_CHUNK_SIZE=1000
RANDOM_SEED=42

# Mapeo manual de columnas CSV (vacío = autodetección por alias).
REVIEWS_COL_REVIEW_ID=
REVIEWS_COL_PRODUCT_ID=
REVIEWS_COL_USER_ID=
REVIEWS_COL_RATING=
REVIEWS_COL_TEXT=
REVIEWS_COL_PROFILE=

# --- Kafka ------------------------------------------------------------------
KAFKA_BROKERS=kafka:29092
KAFKA_BROKERS_HOST=localhost:9092
KAFKA_TOPIC=user-navigation-events
KAFKA_CLIENT_ID=ecommerce-rec
KAFKA_CONSUMER_GROUP=ecommerce-rec-consumer

# --- Cassandra --------------------------------------------------------------
CASSANDRA_CONTACT_POINTS=cassandra
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=ecommerce_rec
CASSANDRA_LOCAL_DATACENTER=datacenter1
CASSANDRA_MAX_HEAP=512M
CASSANDRA_HEAP_NEWSIZE=100M

# --- Neo4j ------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123
NEO4J_HEAP=256m

# --- Backend / Frontend -----------------------------------------------------
BACKEND_PORT=4000
FRONTEND_PORT=5173
API_PROXY_TARGET=http://backend:4000
RECOMMENDATION_LIMIT=10
LOG_LEVEL=info

# --- Spark ------------------------------------------------------------------
SPARK_MASTER_URL=spark://spark-master:7077
SPARK_APP_NAME=ecommerce-als-recommender
SPARK_CASSANDRA_PACKAGE=com.datastax.spark:spark-cassandra-connector_2.12:3.5.0
SPARK_WORKER_MEMORY=1G
SPARK_WORKER_CORES=1
SPARK_ALS_RANK=10
SPARK_ALS_ITERATIONS=10
SPARK_ALS_REGPARAM=0.1
